# Copy to .env.local. Every variable is optional; the values below are the defaults.

# "local" (default) or "cloud". Cloud only changes the LLM; image and voice stay local.
GENERATION_MODE=local

# ── LLM: any OpenAI-compatible chat endpoint ──
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=om-mlx-1.0
# omlx-server demands a real key (see ~/.omlx/settings.json -> auth.api_key);
# export it here, or in your shell via ~/.env.secrets.
#OMLX_API_KEY=
# Local reasoning models (e.g. Qwen3) think for minutes; thinking is off unless true.
LLM_THINKING=false

# Used when GENERATION_MODE=cloud
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gpt-4o

# ── Voice (mlx-audio) ──
TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-bf16
TTS_VOICE=Ryan

# Target frame images default to 768x432 at 20 steps. Reducing size/steps speeds
# generation; increase them for more detail. Dimensions must be multiples of 16.
#IMAGE_STEPS=20
#FRAME_IMAGE_WIDTH=768
#FRAME_IMAGE_HEIGHT=432
# Defaults for standalone generated reference images.
#IMAGE_WIDTH=768
#IMAGE_HEIGHT=768
# Hard cap on one mflux spawn, seconds (default 3600).
# Override for slower inference or a cold model-weight download.
#IMAGE_TIMEOUT_SECONDS=3600

# HuggingFace token for mflux model-weight downloads. Inference itself is local
# MLX on Apple Silicon; only the first download talks to HF.
#HF_TOKEN=

# ── Storage ──
DB_PATH=./data/storyboard.db
IMAGE_MEDIA_DIR=./public/media
TTS_MEDIA_DIR=./public/media
